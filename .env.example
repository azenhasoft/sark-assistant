# Copie estes valores para as variáveis de ambiente do seu terminal.
# O SARK usa Ollama local e não precisa de chave de API.
SARK_PROVIDER=ollama
SARK_MODEL=qwen3:4b
SARK_OLLAMA_BASE_URL=http://localhost:11434
SARK_OLLAMA_TIMEOUT_SECONDS=300

# Caminho local do banco SQLite. O arquivo é ignorado pelo Git.
SARK_DATABASE_PATH=~/.sark/memory.sqlite3

# Para usar a demonstração sem IA, altere SARK_PROVIDER para demo.
